{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "ignorePaths": [
    "**/node_modules/**",
    "**/bower_components/**",
    "**/vendor/**",
    "**/examples/**",
    "**/__tests__/**",
    "**/test/**",
    "**/tests/**",
    "**/__fixtures__/**",
    "**/fixtures/**"
  ],
  "minimumReleaseAge": "3 days",
  "osvVulnerabilityAlerts": true,
  "packageRules": [
    {
      "description": "Our own actions and reusable workflows have the same maintainers as the repos that use them, so their releases are used without waiting",
      "matchManagers": [
        "github-actions"
      ],
      "matchPackageNames": [
        "simp/**"
      ],
      "minimumReleaseAge": null
    }
  ]
}
