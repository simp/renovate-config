{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "description": "Configuration for Ruby-related projects",
  "customManagers": [
    {
      "customType": "regex",
      "description": "Update pessimistic (`~>`) environment variable defaults in Gemfiles. The version number alone is the current value, so the update is a plain version replacement that keeps the `~>`",
      "managerFilePatterns": [
        "/(^|/)Gemfile(\\.(local|project))?$/"
      ],
      "matchStrings": [
        "#\\s*renovate:\\s*datasource=(?<datasource>\\S+)(?:\\s+versioning=(?<versioning>\\S+))?\\s+.*?['\"](?<depName>[\\w_-]+)['\"].*?['\"]~>\\s*(?<currentValue>\\d+(?<minorPart>\\.\\d+)?(?<patchPart>\\.\\d+)?)['\"]"
      ],
      "extractVersionTemplate": "^v?(?<version>\\d+{{#if minorPart}}\\.\\d+{{/if}}{{#if patchPart}}\\.\\d+{{/if}})(?:\\.\\d+)*$",
      "depTypeTemplate": "pessimistic"
    },
    {
      "customType": "regex",
      "description": "Update exact (`'1.2.3'` or `'= 1.2.3'`) environment variable defaults in Gemfiles",
      "managerFilePatterns": [
        "/(^|/)Gemfile(\\.(local|project))?$/"
      ],
      "matchStrings": [
        "#\\s*renovate:\\s*datasource=(?<datasource>\\S+)(?:\\s+versioning=(?<versioning>\\S+))?\\s+.*?['\"](?<depName>[\\w_-]+)['\"].*?['\"](?<currentValue>(?:=\\s*)?\\d+(?:\\.\\d+)*)['\"]"
      ]
    },
    {
      "customType": "regex",
      "description": "Update pessimistic (`~>`) gemspec dependencies",
      "managerFilePatterns": [
        "/\\.gemspec$/"
      ],
      "matchStrings": [
        "\\.add(?:_runtime|_development)?_dependency[\\s(]+['\"](?<depName>[\\w_-]+)['\"].*?['\"]~>\\s*(?<currentValue>\\d+(?<minorPart>\\.\\d+)?(?<patchPart>\\.\\d+)?)['\"]"
      ],
      "datasourceTemplate": "rubygems",
      "versioningTemplate": "ruby",
      "extractVersionTemplate": "^v?(?<version>\\d+{{#if minorPart}}\\.\\d+{{/if}}{{#if patchPart}}\\.\\d+{{/if}})(?:\\.\\d+)*$",
      "depTypeTemplate": "pessimistic"
    },
    {
      "customType": "regex",
      "description": "Update exact (`'1.2.3'` or `'= 1.2.3'`) gemspec dependencies",
      "managerFilePatterns": [
        "/\\.gemspec$/"
      ],
      "matchStrings": [
        "\\.add(?:_runtime|_development)?_dependency[\\s(]+['\"](?<depName>[\\w_-]+)['\"].*?['\"](?<currentValue>(?:=\\s*)?\\d+(?:\\.\\d+)*)['\"]"
      ],
      "datasourceTemplate": "rubygems",
      "versioningTemplate": "ruby"
    },
    {
      "customType": "regex",
      "description": "Update Ruby versions in GitHub Actions matrix entries (which the github-actions manager doesn't see), marked with a `# renovate: datasource=ruby-version depName=ruby` comment",
      "managerFilePatterns": [
        "/(^|/)\\.github/workflows/[^/]+\\.ya?ml$/",
        "/(^|/)_github/workflows/[^/]+\\.ya?ml$/"
      ],
      "matchStrings": [
        "ruby_version:\\s*['\"]?(?<currentValue>\\d+\\.\\d+\\.\\d+)['\"]?\\s*#\\s*renovate:\\s*datasource=(?<datasource>[a-z-]+)\\s+depName=(?<depName>[\\w.-]+)"
      ],
      "versioningTemplate": "ruby"
    }
  ],
  "packageRules": [
    {
      "description": "`~> X.Y` already allows newer X.Y releases, so only offer a new major (e.g. `~> 8.0` -> `~> 9.1`)",
      "matchManagers": [
        "custom.regex"
      ],
      "matchDepTypes": [
        "pessimistic"
      ],
      "matchCurrentValue": "/^\\d+\\.\\d+$/",
      "matchUpdateTypes": [
        "minor",
        "patch"
      ],
      "enabled": false
    },
    {
      "description": "`~> X.Y.Z` already allows newer X.Y.Z releases, so only offer a new minor or major (e.g. `~> 4.0.0` -> `~> 4.1.2`)",
      "matchManagers": [
        "custom.regex"
      ],
      "matchDepTypes": [
        "pessimistic"
      ],
      "matchCurrentValue": "/^\\d+\\.\\d+\\.\\d+$/",
      "matchUpdateTypes": [
        "patch"
      ],
      "enabled": false
    },
    {
      "description": "Offer Ruby patch updates separately from minor ones. Otherwise a pinned 3.2.x is only offered the newest non-major Ruby (e.g. 3.4.x), which the next rule disables, so it never gets a 3.2 patch release",
      "matchDatasources": [
        "ruby-version"
      ],
      "separateMinorPatch": true
    },
    {
      "description": "Only take patch updates for Ruby itself. CI Ruby versions are pinned per major.minor on purpose (e.g. 3.2 is the Ruby the OpenVox 8 agent ships, 4.0 is OpenVox 9's), so moving to a new minor or major is a deliberate change made by hand",
      "matchDatasources": [
        "ruby-version"
      ],
      "matchUpdateTypes": [
        "major",
        "minor"
      ],
      "enabled": false
    },
    {
      "description": "Group Ruby patch updates into one PR per repository",
      "matchDatasources": [
        "ruby-version"
      ],
      "matchUpdateTypes": [
        "patch"
      ],
      "groupName": "Ruby patch versions",
      "groupSlug": "ruby"
    }
  ]
}
