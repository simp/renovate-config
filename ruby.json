{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "description": "Configuration for Ruby-related projects",
  "customManagers": [
    {
      "customType": "regex",
      "description": "Update environment variable defaults",
      "managerFilePatterns": [
        "/(^|/)Gemfile(\\.(local|project))?$/"
      ],
      "matchStrings": [
        "#\\s*renovate:\\s*datasource=(?<datasource>\\S+)(?:\\s+versioning=(?<versioning>\\S+))?\\s+.*?['\"](?<depName>[\\w_-]+)['\"].*?['\"](?<currentValue>(?:=|~>|<)?\\s*\\d+(?:\\.\\d+)*)['\"]"
      ]
    },
    {
      "customType": "regex",
      "description": "Update gemspec dependencies",
      "managerFilePatterns": [
        "/\\.gemspec$/"
      ],
      "matchStrings": [
        "\\.add(?:_runtime|_development)?_dependency\\s+['\"](?<depName>[\\w_-]+)['\"].*?['\"](?<currentValue>(?:=|~>|<)?\\s*\\d+(?:\\.\\d+)*)['\"]"
      ],
      "datasourceTemplate": "rubygems",
      "versioningTemplate": "ruby"
    }
  ],
  "packageRules": [
    {
      "description": "Applies \":preserveSemverRanges\" to the custom manager above. See: https://github.com/renovatebot/renovate/discussions/28090",
      "matchDatasources": [
        "rubygems"
      ],
      "matchManagers": [
        "custom.regex"
      ],
      "rangeStrategy": "replace"
    }
  ]
}
